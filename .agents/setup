#!/usr/bin/env bash
# Reel Maestro orb setup.
# Amp runs this once from the repo root when preparing a fresh orb.
# Keep it idempotent: it may run on a clean image or a warm snapshot.
set -euo pipefail

echo "==> Reel Maestro orb setup"

# --- Local env file ------------------------------------------------------
# Copy the template if no local env exists yet. Never overwrite (-n) so a
# real key injected via project secrets/env vars is preserved. OPENROUTER_API_KEY
# and REELMAESTRO_* values should come from Amp project Settings, not this file.
if [ ! -f .env ]; then
  cp -n .env.example .env
  echo "==> Created .env from .env.example (set OPENROUTER_API_KEY via project secrets)"
fi

# --- Rust toolchain (MSRV 1.88) -----------------------------------------
# Debian 12 orbs do not ship Rust; install via rustup if missing.
# Load an earlier setup's installation before deciding whether Rust is absent.
# shellcheck disable=SC1090,SC1091
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
if ! command -v cargo >/dev/null 2>&1; then
  echo "==> Installing Rust toolchain via rustup"
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain 1.88.0 --profile minimal --component clippy,rustfmt
fi
# The installer creates this file during the current run.
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Ensure clippy and rustfmt are present even on a pre-existing toolchain.
rustup component add clippy rustfmt >/dev/null 2>&1 || true

echo "==> Toolchain: $(rustc --version), $(cargo --version)"

# --- System packages -----------------------------------------------------
# ffmpeg/ffprobe drive local render and the ignored smoke tests. Orbs usually
# ship ffmpeg already; install only if absent.
if ! command -v ffprobe >/dev/null 2>&1; then
  echo "==> Installing ffmpeg"
  sudo apt-get update -qq
  sudo apt-get install -y -qq ffmpeg
fi

# --- Warm the build cache -----------------------------------------------
echo "==> Building Reel Maestro"
# `cargo build` fetches missing dependencies itself. Optional caption and CI
# tools are intentionally left to the documented opt-in setup in CONTRIBUTING.md.
cargo build --locked

echo "==> Reel Maestro orb setup complete"
