#!/usr/bin/env bash
# Reel Maestro orb setup.
# Amp runs this once from the repo root when preparing a fresh orb.
# Keep it idempotent: it may run on a clean image or a warm snapshot.
set -euo pipefail

echo "==> Reel Maestro orb setup"

# --- Local env file ------------------------------------------------------
# Copy the template if no local env exists yet. Never overwrite (-n) so a
# real key injected via project secrets/env vars is preserved. OPENROUTER_API_KEY
# and REELMAESTRO_* values should come from Amp project Settings, not this file.
if [ ! -f .env ]; then
  cp -n .env.example .env
  echo "==> Created .env from .env.example (set OPENROUTER_API_KEY via project secrets)"
fi

# --- Rust toolchain (MSRV 1.88) -----------------------------------------
# Amp/E2B base orbs do not necessarily ship Rust. Install via rustup if missing so agents can run
# the required cargo fmt/clippy/test/build/package checks before handing work back.
if ! command -v cargo >/dev/null 2>&1; then
  echo "==> Installing Rust toolchain via rustup"
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain 1.88.0 --profile minimal --component clippy --component rustfmt
fi
# shellcheck disable=SC1090,SC1091
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Ensure clippy and rustfmt are present even on a pre-existing toolchain.
rustup component add clippy rustfmt >/dev/null 2>&1 || true

echo "==> Toolchain: $(rustc --version), $(cargo --version)"

# --- System packages -----------------------------------------------------
# ffmpeg/ffprobe drive local render and the ignored smoke tests. Orbs usually
# ship ffmpeg already; install only if absent.
if ! command -v ffprobe >/dev/null 2>&1; then
  echo "==> Installing ffmpeg"
  sudo apt-get update -qq
  sudo apt-get install -y -qq ffmpeg
fi

# --- CI / supply-chain cargo tools --------------------------------------
# Match the tooling in CONTRIBUTING.md: cargo deny / audit / cyclonedx.
# cargo-binstall fetches prebuilt binaries when available, else builds from source.
if ! command -v cargo-binstall >/dev/null 2>&1; then
  curl -L --proto '=https' --tlsv1.2 -sSf \
    https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash || true
fi
for tool in cargo-deny cargo-audit cargo-cyclonedx; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "==> Installing $tool"
    cargo binstall -y "$tool" 2>/dev/null || cargo install --locked "$tool" || true
  fi
done

# --- Optional: local caption timing -------------------------------------
# whisper-timestamped provides local word-level caption timing (not an API call).
# Optional; do not fail orb setup if it cannot be installed.
if ! command -v whisper_timestamped >/dev/null 2>&1; then
  echo "==> Installing whisper-timestamped (optional)"
  pip install --quiet --user whisper-timestamped >/dev/null 2>&1 || \
    echo "==> whisper-timestamped install skipped (captions can still be disabled with --no-captions)"
fi

# --- Warm the build cache -----------------------------------------------
echo "==> Fetching dependencies and building"
cargo fetch --locked
cargo build --locked

echo "==> Reel Maestro orb setup complete"
