{
  "name": "reelmaestro-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite build --watch --config web/vite.config.ts",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts",
    "test:browser": "tsx tests/browser.ts",
    "format": "prettier --write '{web,server,tests}/**/*.{ts,tsx,js,css,html}' shared.ts package.json tsconfig.json",
    "format:check": "prettier --check '{web,server,tests}/**/*.{ts,tsx,js,css,html}' shared.ts package.json tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "fastify": "5.12.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "playwright-core": "1.63.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
